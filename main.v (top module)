`timescale 1ns / 1ps

module main #(
    parameter DEPTH = 5,
    parameter SIZE = 2**DEPTH
)(
    input wire rst,
    input wire wr_clk,
    input wire rd_clk,
    input wire [31:0] phase_step,
    output wire [31:0] tdata,
    output wire tvalid,
    input wire tready
);

    wire [31:0] iq_data;
    wire iq_valid;
    wire iq_ready;

    wire [31:0] fifo_dout;
    wire fifo_empty;
    wire fifo_full;

    wire fifo_rd_en;
    wire fifo_wr_en;

    iq_generator #(
        .PW(32),
        .ADDR_WIDTH(8)
    ) u_iq_generator (
        .clk(wr_clk),
        .rst(rst),
        .phase_step(phase_step),
        .iq_data(iq_data),
        .iq_valid(iq_valid),
        .iq_ready(iq_ready)
    );

    assign fifo_wr_en = iq_valid && !fifo_full; //Write to fifo when i/q data is valid and fifo is not full
    assign iq_ready = !fifo_full; //Tell i/q generator when fifo can accept data
    assign fifo_rd_en = tvalid && tready; //Read when handshake occours

    fwft_axi4s #(
        .DEPTH(DEPTH),
        .SIZE(SIZE)
    ) u_fifo(
        .rstrst),
        .wr_clk(wr_clk),
        .wr_en(fifo_wr_en),
        .din(iq_data),
        .full(fifo_full),
        .rd_clk(rd_clk),
        .rd_en(fifo_rd_en),
        .dout(fifo_dout),
        .empty(fifo_empty)
    );

    //Send data to AXI
    assign tdata  = fifo_dout;
    assign tvalid = !fifo_empty;

endmodule
